{
  "name": "quick-pet",
  "version": "0.12.6",
  "description": "可自定义的 Windows 桌宠快捷收纳器",
  "main": "src/main/main.js",
  "author": "云间溯工作室",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunsuStudio/QuickPet.git"
  },
  "homepage": "https://github.com/YunsuStudio/QuickPet#readme",
  "bugs": {
    "url": "https://github.com/YunsuStudio/QuickPet/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "icons": "node scripts/generate-icons.js",
    "ensure:electron": "node node_modules/electron/install.js",
    "bundle:3d": "esbuild src/renderer/pet-3d-entry.js --bundle --format=iife --global-name=QuickPet3DBundle --outfile=src/renderer/vendor/pet-3d.bundle.js --minify",
    "bundle:live2d": "node scripts/copy-live2d-runtime.js && esbuild src/renderer/pet-live2d-entry.js --bundle --format=iife --global-name=QuickPetLive2DBundle --outfile=src/renderer/vendor/pet-live2d.bundle.js --minify",
    "bundle:renderers": "npm run bundle:3d && npm run bundle:live2d",
    "pack": "npm run ensure:electron && npm run bundle:renderers && electron-builder --dir --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-packaged-launch.ps1",
    "build:portable": "npm run pack && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-portable-launcher.ps1",
    "build": "npm run build:portable"
  },
  "devDependencies": {
    "@hazart-pkg/live2d-core": "^1.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.8",
    "pixi.js": "^8.13.1",
    "three": "^0.179.1",
    "untitled-pixi-live2d-engine": "^1.3.5"
  },
  "build": {
    "appId": "com.quickpet.launcher",
    "productName": "快捷宠",
    "copyright": "Copyright © 2026 云间溯工作室",
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "extract-zip": "^2.0.1"
  }
}
